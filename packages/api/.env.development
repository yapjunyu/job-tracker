# Used by `pnpm dev` only. Points at the local Postgres from docker compose's `local-db` profile,
# so development never touches a real database. Variables already set in your shell take precedence.
DATABASE_URL=postgres://jobtracker:jobtracker@localhost:5432/jobtracker
PORT=3000
# Development only: anyone can read this one, so it must never sign real sessions.
AUTH_SECRET=development-only-secret-never-use-for-real-sessions

# The browser talks to Vite on 5173, which forwards /api here, so 5173 is the origin it sends.
# Left unset, Better Auth takes the address from the forwarded request and refuses the mismatch.
APP_URL=http://localhost:5173
