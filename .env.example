# Copy this file to .env, then run `docker compose up --detach`.

# The release to run. `latest` follows the newest release; pin a version, such as
# ghcr.io/yapjunyu/job-tracker:1.2.0, to decide for yourself when to update.
APP_IMAGE=ghcr.io/yapjunyu/job-tracker:latest

# Starts the local Postgres container alongside the app. Remove this line to use your own
# database instead, such as Neon, and point DATABASE_URL at it.
COMPOSE_PROFILES=local-db

# Postgres connection string. The default is the local Postgres container.
DATABASE_URL=postgres://jobtracker:jobtracker@postgres:5432/jobtracker

# Port on this machine where the app is served: http://localhost:3000
APP_PORT=3000

# Required. Signs session cookies; changing it signs everyone out. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# The address people open the app at, such as https://jobs.example.com. Leave empty to take it
# from each request, which works for http://localhost. Set it when the app is behind HTTPS.
APP_URL=

# Comma-separated email addresses allowed to sign up. Leave empty to let anyone sign up.
INVITE_LIST=
