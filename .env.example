# Copy this file to .env, then run `docker compose up`.

# Starts the local Postgres container alongside the app. Remove this line to use your own
# database instead, such as Neon, and point DATABASE_URL at it.
COMPOSE_PROFILES=local-db

# Postgres connection string. The default is the local Postgres container.
DATABASE_URL=postgres://jobtracker:jobtracker@postgres:5432/jobtracker

# Port on this machine where the app is served: http://localhost:3000
APP_PORT=3000
